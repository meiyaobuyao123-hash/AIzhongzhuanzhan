# Prism backend env vars
# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PRISM_HOST=127.0.0.1
PRISM_PORT=8765
PRISM_LOG_LEVEL=INFO
PRISM_DEBUG=false

# --- Database ---
# Dev / MVP: SQLite
PRISM_DATABASE_URL=sqlite+aiosqlite:///./prism.db
# Prod (later): Postgres
# PRISM_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/prism

# --- Crypto ---
# AES-256-GCM master key for upstream API key encryption.
# Generate with: openssl rand -hex 32
PRISM_MASTER_KEY_HEX=__GENERATE_WITH_openssl_rand_hex_32__

# --- Routing / timeouts ---
PRISM_REQUEST_TIMEOUT_S=600
PRISM_UPSTREAM_CONNECT_TIMEOUT_S=10

# --- Billing ---
# Top-up fee, in basis points. 5 = 万分之五 (0.05%)
PRISM_TOPUP_FEE_BASIS_POINTS=5
