# Prism backend env vars
# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PRISM_HOST=127.0.0.1
PRISM_PORT=8765
PRISM_LOG_LEVEL=INFO
PRISM_DEBUG=false

# --- Database ---
# Dev / MVP: SQLite
PRISM_DATABASE_URL=sqlite+aiosqlite:///./prism.db
# Prod (later): Postgres
# PRISM_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/prism

# --- Crypto ---
# AES-256-GCM master key for upstream API key encryption.
# Generate with: openssl rand -hex 32
PRISM_MASTER_KEY_HEX=__GENERATE_WITH_openssl_rand_hex_32__

# --- Routing / timeouts ---
PRISM_REQUEST_TIMEOUT_S=600
PRISM_UPSTREAM_CONNECT_TIMEOUT_S=10

# --- Billing ---
# Top-up fee, in basis points. 5 = 万分之五 (0.05%)
PRISM_TOPUP_FEE_BASIS_POINTS=5

# --- Redis (rate limit, cooldown, oauth state, sticky route) ---
PRISM_REDIS_URL=redis://127.0.0.1:6379/0

# --- JWT (web session) ---
# Generate: openssl rand -hex 32
PRISM_JWT_SECRET=__GENERATE_WITH_openssl_rand_hex_32__
PRISM_JWT_TTL_DAYS=30

# --- Default rate limit tiers (RPM, by cumulative top-up USD) ---
PRISM_RPM_TIER_LT_50=60
PRISM_RPM_TIER_LT_500=240
PRISM_RPM_TIER_LT_5000=600
PRISM_RPM_TIER_GE_5000=1200

# --- OAuth (optional; leave empty to disable that provider) ---
PRISM_OAUTH_GITHUB_CLIENT_ID=
PRISM_OAUTH_GITHUB_CLIENT_SECRET=
PRISM_OAUTH_GOOGLE_CLIENT_ID=
PRISM_OAUTH_GOOGLE_CLIENT_SECRET=
PRISM_OAUTH_REDIRECT_BASE=https://www.ai100trading.cn/suanli-api

# --- SMTP (optional; if empty, verification links log to journal) ---
PRISM_SMTP_HOST=
PRISM_SMTP_PORT=587
PRISM_SMTP_USER=
PRISM_SMTP_PASSWORD=
PRISM_SMTP_FROM="Prism <noreply@ai100trading.cn>"
PRISM_FRONTEND_BASE=https://www.ai100trading.cn
